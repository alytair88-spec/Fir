# Copy to .env.local and fill in values from Supabase → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Needed for Android release builds (Google Cloud → Maps SDK for Android).
GOOGLE_MAPS_ANDROID_API_KEY=
# Optional: only if you want Google Maps instead of Apple Maps on iOS.
GOOGLE_MAPS_IOS_API_KEY=
